# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=alumni_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Secret key for signing JWTs — use a long random string in production
JWT_SECRET=supersecretencryptionkey_CHANGE_ME_IN_PRODUCTION
# Token expiry for alumni (1h) and university staff (8h)
JWT_EXPIRES_IN=1h

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
# University staff email verification & password resets are sent via this account
EMAIL_USER=your_email@university.edu
EMAIL_PASS=your_email_app_password
EMAIL_FROM="AlumniIntel Dashboard <noreply@university.edu>"

# ─── CORS / Frontend ──────────────────────────────────────────────────────────
# URL where the frontend dashboard is served from (used for CORS)
FRONTEND_URL=http://localhost:3000

# ─── API Key Scoping ──────────────────────────────────────────────────────────
# Client types and their auto-assigned permissions:
#   analytics_dashboard → ["read:alumni","read:analytics"]
#   mobile_ar           → ["read:alumni_of_the_day"]
#   general             → ["read:alumni"]
# Generate keys via: POST /api/developer/keys  { name, clientType }
